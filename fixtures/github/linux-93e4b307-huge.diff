-#define GRU_CB_IAA1_SHFT	13
-#define GRU_CB_IAA1_MASK	0x3
-#define GRU_CB_IMA_SHFT		1
-#define GRU_CB_IMA_MASK		0x3
-#define GRU_CB_OPC_SHFT		16
-#define GRU_CB_OPC_MASK		0xff
