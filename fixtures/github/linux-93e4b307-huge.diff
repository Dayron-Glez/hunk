-/* GRU instruction opcodes (opc field) */
-#define OP_NOP		0x00
-#define OP_BCOPY	0x01
-#define OP_VLOAD	0x02
-#define OP_IVLOAD	0x03
-#define OP_VSTORE	0x04
-#define OP_IVSTORE	0x05
-#define OP_VSET		0x06
-#define OP_IVSET	0x07
