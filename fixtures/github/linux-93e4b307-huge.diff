-__opdword(unsigned char opcode, unsigned char exopc, unsigned char xtype,
-       unsigned char iaa0, unsigned char iaa1,
-       unsigned long idef2, unsigned char ima)
-{
-    return (1 << GRU_CB_ICMD_SHFT) |
