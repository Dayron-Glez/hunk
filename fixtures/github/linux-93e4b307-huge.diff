-
-	memset(buf2, 0, sizeof(buf2));
-	memset(buf1, get_cycles() & 255, sizeof(buf1));
-	gru_copy_gpa(uv_gpa(buf2), uv_gpa(buf1), BUFSIZE);
-	if (memcmp(buf1, buf2, BUFSIZE)) {
-		printk(KERN_DEBUG "GRU:%d quicktest3 error\n", smp_processor_id());
-		ret = -EIO;
-	}
