-
-	BUG_ON(msg_slot->msg_slot_number != msg->hdr.msg_slot_number);
-	msg_slot->msg_slot_number += ch->local_nentries;
-
-	if (msg_slot->func != NULL)
-		xpc_notify_sender_uv(ch, msg_slot, xpMsgDelivered);
-
-	xpc_free_msg_slot_uv(ch, msg_slot);
