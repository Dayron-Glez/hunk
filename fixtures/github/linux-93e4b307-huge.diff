-    /* DW 1 */
-    unsigned long		idef4;		/* 42 bits: TRi1, BufSize */
-    /* DW 2-6 */
-    unsigned long		idef1;		/* BAddr0 */
-    unsigned long		idef5;		/* Nelem */
