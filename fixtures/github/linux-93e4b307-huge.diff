-		dev_dbg(xpc_chan, "msg_slot->func() called, msg_slot=0x%p "
-			"msg_slot_number=%d partid=%d channel=%d\n", msg_slot,
-			msg_slot->msg_slot_number, ch->partid, ch->number);
