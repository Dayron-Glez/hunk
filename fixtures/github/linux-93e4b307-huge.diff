-    unsigned long		op2_value_baddr1;	/* DW 5 */
-    unsigned long		reserved0;		/* DW 6 */
-    unsigned long		avalue;			/* DW 7 */
-};
-
-/* Some shifts and masks for the low 64 bits of a GRU command */
